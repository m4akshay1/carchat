# Copy to .env and fill in. Never commit .env.

# Anthropic API key used by the chat route.
ANTHROPIC_API_KEY=

# Read-only database users, one per role. Each can SELECT from its own view only.
#   postgresql://sales_reader:<password>@<host>:5432/carchat
DATABASE_URL_SALES=
#   postgresql://gm_reader:<password>@<host>:5432/carchat
DATABASE_URL_GM=

# Demo passcodes that pick the role, and the key that signs the session cookie.
SALES_PASSCODE=
GM_PASSCODE=
SESSION_SECRET=

# Used only by scripts/seed.py to rebuild the database. Never set this on the host.
ADMIN_DATABASE_URL=
